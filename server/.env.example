# Copy this file to .env and fill it in. docker-compose.yml passes these to the db and api containers.

# Database login (also creates the database on first start)
POSTGRES_USER=roots
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roots

# API (defaults match docker-compose service names)
POSTGRES_HOST=db
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Signs login tokens.
JWT_SECRET=change-me

# Light level (lux) that counts toward sunlight_hours. Optional; defaults to 1000.
SUNLIGHT_LUX=1000