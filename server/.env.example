# Copy this file to .env and fill it in. docker-compose.yml passes these to the db and api containers.

# Database login (also creates the database on first start)
POSTGRES_USER=roots
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roots

# API (defaults match docker-compose service names)
POSTGRES_HOST=db
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Signs login tokens. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
